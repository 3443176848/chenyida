# Non-secret render interface for the fourth-layer root-operations overlay.
# Blank values are intentional fail-closed placeholders.  This file neither
# creates a UAT environment nor authorizes PostgreSQL, Migration, or deployment.
ERP_UAT_COMPOSE_PROJECT=chenyida-erp-uat-synthetic
ERP_UAT_RUNTIME_SECRET_ROOT=/etc/chenyida-erp-uat-synthetic/runtime-secrets
ERP_UAT_BACKUP_CREDENTIAL_ROOT=/etc/chenyida-erp-uat-synthetic/operator-credentials
ERP_UAT_RELEASE_CANDIDATE_ROOT=/var/lib/chenyida-erp-uat-synthetic/release-candidate
ERP_UAT_RELEASE_IDENTITY_ROOT=/var/lib/chenyida-erp-uat-synthetic/release-identity
ERP_UAT_MIGRATION_GRANT_ROOT=/var/lib/chenyida-erp-uat-synthetic/migration-grant
ERP_UAT_HTTP_PORT=33001
ERP_UAT_CADDY_HTTP_PORT=33080
ERP_UAT_CADDY_HTTPS_PORT=33443

ERP_DEPLOYMENT_CLASS=uat
ERP_RELEASE_EXPECTED_DEPLOYMENT_ID=chenyida-erp-uat-synthetic
ERP_UAT_ALLOW_LOOPBACK_ORIGIN=true
ERP_DOMAIN=localhost
ERP_PUBLIC_ORIGIN=https://localhost:33443
ERP_RELEASE_IDENTITY_READER_GID=65532

# Exact release inputs.  The manifest SHA is reused as the runtime expected
# manifest SHA by compose.uat-operations.yml.
ERP_RELEASE_EXPECTED_VERSION=
ERP_RELEASE_EXPECTED_GIT_COMMIT=
ERP_RELEASE_MANIFEST_SHA256=
ERP_BUILD_VERSION=
ERP_BUILD_REVISION=
ERP_WEB_IMAGE=
ERP_WORKER_IMAGE=
ERP_WEB_IMAGE_CONFIG_DIGEST=
ERP_WORKER_IMAGE_CONFIG_DIGEST=

# These values exist only after PostgreSQL-only startup and a separately
# authorized, short-lived migration grant.  They must never contain secrets.
ERP_MIGRATION_EXPECTED_SYSTEM_IDENTIFIER=
ERP_MIGRATION_EXPECTED_DATABASE_OID=
ERP_UAT_PROMOTION_MIGRATION_GRANT_SHA256=
ERP_UAT_PROMOTION_MIGRATION_EXECUTION_AUTHORIZATION_SHA256=
ERP_ISOLATED_UAT_ROOT_OPERATIONS_PACKAGE_SHA256=

# Invariants are fixed by the overlay rather than operator-entered values:
# MIGRATION_FENCED, MIGRATE_EXACT_RELEASE_MANIFEST, EMPTY, and
# 0046_runtime_lock_privilege_boundary.sql.
