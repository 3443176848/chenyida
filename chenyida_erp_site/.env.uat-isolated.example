# Non-secret planning example for compose.uat-isolated.yml.  Copying this file
# does not create or authorize a UAT environment.  Choose collision-free values
# at the L2a resource gate; these examples are not product or capacity limits.
ERP_UAT_COMPOSE_PROJECT=chenyida-erp-uat-synthetic
ERP_UAT_RUNTIME_SECRET_ROOT=/etc/chenyida-erp-uat-synthetic/runtime-secrets
ERP_UAT_BACKUP_CREDENTIAL_ROOT=/etc/chenyida-erp-uat-synthetic/operator-credentials
ERP_UAT_RELEASE_CANDIDATE_ROOT=/var/lib/chenyida-erp-uat-synthetic/release-candidate
ERP_UAT_RELEASE_IDENTITY_ROOT=/var/lib/chenyida-erp-uat-synthetic/release-identity
ERP_UAT_OPERATOR_STATE_ROOT=/var/lib/chenyida-erp-uat-synthetic/postgresql-runtime-privilege-operator
ERP_UAT_ONE_SHOT_STATE_ROOT=/var/lib/chenyida-erp-uat-synthetic/isolated-uat-one-shot
ERP_UAT_BACKUP_ROOT=/var/backups/chenyida-erp-uat-synthetic
ERP_UAT_HTTP_PORT=33001
ERP_UAT_CADDY_HTTP_PORT=33080
ERP_UAT_CADDY_HTTPS_PORT=33443

# Existing application/release inputs remain required by compose.yml and
# compose.release.yml.  Values below describe a loopback-only UAT contract;
# exact source/image inputs are supplied only after L2a approval.  Isolated UAT
# evidence is not a production release identity.
ERP_DEPLOYMENT_CLASS=uat
ERP_RELEASE_EXPECTED_DEPLOYMENT_ID=chenyida-erp-uat-synthetic
ERP_UAT_ALLOW_LOOPBACK_ORIGIN=true
ERP_DOMAIN=localhost
ERP_PUBLIC_ORIGIN=https://localhost:33443
# Technical container GID from compose.yml; unrelated to staffing or seat count.
ERP_RELEASE_IDENTITY_READER_GID=65532
ERP_RELEASE_EXPECTED_VERSION=
ERP_RELEASE_EXPECTED_GIT_COMMIT=
ERP_BUILD_VERSION=
ERP_BUILD_REVISION=
ERP_WEB_IMAGE=
ERP_WORKER_IMAGE=
ERP_WEB_IMAGE_CONFIG_DIGEST=
ERP_WORKER_IMAGE_CONFIG_DIGEST=
