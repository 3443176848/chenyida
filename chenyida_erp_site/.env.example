# Copy to .env and replace every CHANGE_ME value. Never commit .env.
ERP_ENV=development
ERP_BUILD_VERSION=0.1.0-alpha.44
ERP_BUILD_REVISION=replace-with-40-character-release-commit
POSTGRES_DB=chenyida_erp
POSTGRES_USER=chenyida_erp
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://chenyida_erp:replace-with-the-same-password@postgres:5432/chenyida_erp
ERP_SETUP_TOKEN=replace-with-a-long-random-one-time-setup-token
# Exact browser origin used behind TLS termination; no wildcard or path.
ERP_PUBLIC_ORIGIN=https://erp.example.com
# Production is the default when ERP_ENV=production. Only an explicitly designated
# non-production UAT environment may additionally accept strict loopback origins.
ERP_DEPLOYMENT_CLASS=development
ERP_UAT_ALLOW_LOOPBACK_ORIGIN=false
ERP_UPLOAD_ROOT=/data/chenyida-erp/uploads
ERP_ATTACHMENT_ROOT=/data/chenyida-erp/attachments
# Recovery readiness stays fail-closed until a controlled release task inspects
# the exact running Compose Web/Worker containers and atomically publishes the
# root-owned runtime release identity. The host root must be pre-provisioned as
# root:<reader-gid> mode 0750, with its fixed marker root:<reader-gid> mode 0440;
# Compose mounts it read-only at /run/chenyida-erp-release. Image identities are
# read from Docker inspection evidence and are never asserted by these env values.
ERP_RELEASE_IDENTITY_HOST_ROOT=/var/lib/chenyida-erp/release-identity
ERP_RELEASE_IDENTITY_READER_GID=1000
ERP_RELEASE_EXPECTED_DEPLOYMENT_ID=replace-with-compose-project-id
ERP_RELEASE_EXPECTED_VERSION=0.1.0-alpha.44
ERP_RELEASE_EXPECTED_GIT_COMMIT=replace-with-40-character-release-commit
# Accept 60..604800 seconds; stale or future-dated evidence fails closed.
ERP_RELEASE_IDENTITY_MAX_AGE_SECONDS=86400
# Database name/system identity, locale profile and migration manifest are read
# from PostgreSQL; these remaining values approve the recovery policy boundary.
ERP_BACKUP_POLICY_ID=replace-with-approved-policy-id
ERP_BACKUP_RPO_HOURS=24
ERP_BACKUP_EXPECTED_OFFHOST_LOCATION_ID=replace-with-approved-receiver-location
ERP_BACKUP_EXPECTED_OFFHOST_RECEIVER_IDENTITY_SHA256=replace-with-64-character-receiver-identity
ERP_BACKUP_EXPECTED_RESTORE_LOCATION_ID=replace-with-approved-restore-executor-location
ERP_BACKUP_EXPECTED_RESTORE_TARGET_ID=replace-with-approved-isolated-test-target
ERP_BACKUP_EXPECTED_RESTORE_TARGET_SYSTEM_IDENTIFIER=replace-with-approved-distinct-test-cluster-system-identifier
ERP_BACKUP_EXPECTED_RESTORE_TARGET_CLUSTER_MARKER_ID=replace-with-approved-test-cluster-marker-id
# Set only after the root executor, fixed roots, receiver, and reader group have
# been reviewed. This mode is an explicit trust boundary, not cryptographic proof.
ERP_BACKUP_EVIDENCE_TRUST_MODE=
ERP_MAX_UPLOAD_BYTES=10485760
ERP_WORKER_POLL_MS=1000
ERP_WORKER_LEASE_SECONDS=60
DATABASE_POOL_MAX=10
PORT=3000

# Used only by `docker compose --profile production up`.
ERP_DOMAIN=erp.example.com

# Supply these only to the one-shot admin command; never store a real password here.
# ERP_ADMIN_USERNAME=admin
# ERP_ADMIN_DISPLAY_NAME=系统管理员
# ERP_ADMIN_PASSWORD=CHANGE_ME_AT_COMMAND_TIME
