{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chenyida.invalid/schemas/agent-control/message-v1.schema.json",
  "title": "ERP Agent Message v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "message_type",
    "created_at",
    "task_id",
    "agent",
    "role",
    "gate",
    "input",
    "assumptions",
    "evidence",
    "changes",
    "tests",
    "risks",
    "blockers",
    "recommendation",
    "status",
    "minority_report",
    "resolves_message_ids",
    "resolves_claim_ids",
    "checkpoint"
  ],
  "properties": {
    "schema_version": {"const": "erp-agent-message/v1"},
    "message_id": {"$ref": "#/$defs/uuid"},
    "message_type": {
      "enum": [
        "PLAN",
        "HANDOFF",
        "FINDING",
        "VERIFICATION",
        "VETO",
        "MINORITY_REPORT",
        "CHECKPOINT",
        "RECOVERY",
        "CLOSURE"
      ]
    },
    "created_at": {"$ref": "#/$defs/rfc3339"},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{0,63}$"},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "instance_id", "capability_profile", "context_manifest_digest"],
      "properties": {
        "agent_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "instance_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "capability_profile": {
          "enum": [
            "SYNTHETIC_BUILDER",
            "ERP_READ_ONLY",
            "ADVERSARIAL_READ_ONLY",
            "SECURITY_READ_ONLY",
            "QA_TEST_READ_ONLY",
            "BLACK_BOX_PUBLIC_ONLY"
          ]
        },
        "context_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "role": {
      "enum": [
        "CHANGE_BUILDER",
        "ERP_CONTRACT_GUARDIAN",
        "ADVERSARIAL_EXAMINER",
        "SECURITY_BOUNDARY_EXAMINER",
        "INDEPENDENT_VERIFIER",
        "BLACK_BOX_VERIFIER"
      ]
    },
    "gate": {
      "enum": ["IMPLEMENTATION", "ERP_CONTRACT", "ADVERSARIAL", "SECURITY", "QA", "BLACK_BOX", "RECOVERY", "CLOSURE"]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_sha",
        "candidate_sha",
        "task_packet_revision",
        "lease_generation",
        "attempt",
        "artifacts"
      ],
      "properties": {
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "candidate_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|sha256:[0-9a-f]{64})$"},
        "task_packet_revision": {"type": "integer", "minimum": 1},
        "lease_generation": {"type": "integer", "minimum": 1},
        "attempt": {"type": "integer", "minimum": 1},
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "assumptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "status", "source"],
        "properties": {
          "id": {"type": "string", "pattern": "^A-[0-9]{3}$"},
          "statement": {"type": "string", "minLength": 1, "maxLength": 1024},
          "status": {"enum": ["VERIFIED", "PENDING"]},
          "source": {"type": ["string", "null"], "minLength": 1, "maxLength": 512}
        }
      }
    },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "changes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "action", "purpose"],
        "properties": {
          "path": {"$ref": "#/$defs/repositoryPath"},
          "action": {"enum": ["ADD", "MODIFY", "DELETE"]},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    },
    "tests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command_id", "environment", "result", "exit_code", "artifact"],
        "properties": {
          "id": {"type": "string", "pattern": "^T-[0-9]{3}$"},
          "command_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "environment": {"type": "string", "minLength": 1, "maxLength": 256},
          "result": {"enum": ["PASS", "FAIL", "NOT_RUN", "RESULT_UNKNOWN"]},
          "exit_code": {"type": ["integer", "null"], "minimum": -255, "maximum": 255},
          "artifact": {"type": ["string", "null"], "minLength": 1, "maxLength": 128}
        },
        "allOf": [
          {
            "if": {"properties": {"result": {"const": "PASS"}}, "required": ["result"]},
            "then": {"properties": {"exit_code": {"const": 0}, "artifact": {"type": "string"}}}
          },
          {
            "if": {"properties": {"result": {"const": "FAIL"}}, "required": ["result"]},
            "then": {
              "properties": {
                "exit_code": {"type": "integer", "not": {"const": 0}},
                "artifact": {"type": "string"}
              }
            }
          },
          {
            "if": {"properties": {"result": {"const": "NOT_RUN"}}, "required": ["result"]},
            "then": {"properties": {"exit_code": {"type": "null"}, "artifact": {"type": "null"}}}
          },
          {
            "if": {"properties": {"result": {"const": "RESULT_UNKNOWN"}}, "required": ["result"]},
            "then": {"properties": {"exit_code": {"type": "null"}, "artifact": {"type": "string"}}}
          }
        ]
      }
    },
    "risks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "probability", "impact", "trigger", "mitigation", "residual_risk"],
        "properties": {
          "id": {"type": "string", "pattern": "^R-[0-9]{3}$"},
          "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
          "probability": {"enum": ["LOW", "MEDIUM", "HIGH"]},
          "impact": {"type": "string", "minLength": 1, "maxLength": 1024},
          "trigger": {"type": "string", "minLength": 1, "maxLength": 1024},
          "mitigation": {"type": "string", "minLength": 1, "maxLength": 1024},
          "residual_risk": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "attempted", "evidence_refs", "unblock_owner"],
        "properties": {
          "id": {"type": "string", "pattern": "^B-[0-9]{3}$"},
          "category": {"type": "string", "minLength": 1, "maxLength": 128},
          "attempted": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
          "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^E-[0-9]{3}$"}},
          "unblock_owner": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason", "next_action"],
      "properties": {
        "decision": {"type": "string", "minLength": 1, "maxLength": 128},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1024},
        "next_action": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "status": {"enum": ["IN_PROGRESS", "PASS", "FAIL", "VETOED", "BLOCKED", "COMPLETE", "RESULT_UNKNOWN"]},
    "minority_report": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim_id", "opposed_claim", "evidence_refs", "potential_harm", "falsification_test", "requested_disposition"],
          "properties": {
            "claim_id": {"type": "string", "pattern": "^MR-[0-9]{3}$"},
            "opposed_claim": {"type": "string", "minLength": 1, "maxLength": 1024},
            "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^E-[0-9]{3}$"}},
            "potential_harm": {"type": "string", "minLength": 1, "maxLength": 1024},
            "falsification_test": {"type": "string", "minLength": 1, "maxLength": 1024},
            "requested_disposition": {"enum": ["FIX_OR_ESCALATE", "TEST_OR_ESCALATE", "OWNER_DECISION"]}
          }
        }
      ]
    },
    "resolves_message_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/uuid"}
    },
    "resolves_claim_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^MR-[0-9]{3}$"}
    },
    "checkpoint": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate_sha", "task_packet_revision", "lease_generation", "completed_message_ids"],
          "properties": {
            "candidate_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|sha256:[0-9a-f]{64})$"},
            "task_packet_revision": {"type": "integer", "minimum": 1},
            "lease_generation": {"type": "integer", "minimum": 1},
            "completed_message_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/uuid"}
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"message_type": {"const": "PLAN"}}, "required": ["message_type"]},
      "then": {
        "properties": {
          "role": {"const": "CHANGE_BUILDER"},
          "gate": {"const": "IMPLEMENTATION"},
          "status": {"const": "IN_PROGRESS"},
          "minority_report": {"type": "null"},
          "checkpoint": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"message_type": {"const": "HANDOFF"}}, "required": ["message_type"]},
      "then": {
        "properties": {
          "role": {"const": "CHANGE_BUILDER"},
          "gate": {"const": "IMPLEMENTATION"},
          "status": {"const": "PASS"},
          "minority_report": {"type": "null"},
          "checkpoint": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"message_type": {"const": "FINDING"}}, "required": ["message_type"]},
      "then": {
        "properties": {
          "status": {"const": "FAIL"},
          "minority_report": {"type": "null"},
          "checkpoint": {"type": "null"}
        },
        "oneOf": [
          {"properties": {"role": {"const": "ERP_CONTRACT_GUARDIAN"}, "gate": {"const": "ERP_CONTRACT"}}},
          {"properties": {"role": {"const": "ADVERSARIAL_EXAMINER"}, "gate": {"const": "ADVERSARIAL"}}},
          {"properties": {"role": {"const": "SECURITY_BOUNDARY_EXAMINER"}, "gate": {"const": "SECURITY"}}},
          {"properties": {"role": {"const": "INDEPENDENT_VERIFIER"}, "gate": {"const": "QA"}}},
          {"properties": {"role": {"const": "BLACK_BOX_VERIFIER"}, "gate": {"const": "BLACK_BOX"}}}
        ]
      }
    },
    {
      "if": {"properties": {"message_type": {"const": "VERIFICATION"}}, "required": ["message_type"]},
      "then": {
        "properties": {
          "minority_report": {"type": "null"},
          "checkpoint": {"type": "null"}
        },
        "oneOf": [
          {"properties": {"role": {"const": "ERP_CONTRACT_GUARDIAN"}, "gate": {"const": "ERP_CONTRACT"}, "status": {"enum": ["PASS", "FAIL"]}}},
          {"properties": {"role": {"const": "ADVERSARIAL_EXAMINER"}, "gate": {"const": "ADVERSARIAL"}, "status": {"enum": ["PASS", "FAIL"]}}},
          {"properties": {"role": {"const": "SECURITY_BOUNDARY_EXAMINER"}, "gate": {"const": "SECURITY"}, "status": {"enum": ["PASS", "FAIL"]}}},
          {"properties": {"role": {"const": "INDEPENDENT_VERIFIER"}, "gate": {"const": "QA"}, "status": {"enum": ["PASS", "FAIL", "RESULT_UNKNOWN"]}}},
          {"properties": {"role": {"const": "BLACK_BOX_VERIFIER"}, "gate": {"const": "BLACK_BOX"}, "status": {"enum": ["PASS", "FAIL", "RESULT_UNKNOWN"]}}}
        ]
      }
    },
    {
      "if": {"properties": {"message_type": {"const": "VETO"}}, "required": ["message_type"]},
      "then": {
        "properties": {
          "status": {"const": "VETOED"},
          "minority_report": {"type": "null"},
          "checkpoint": {"type": "null"}
        },
        "oneOf": [
          {"properties": {"role": {"const": "ERP_CONTRACT_GUARDIAN"}, "gate": {"const": "ERP_CONTRACT"}}},
          {"properties": {"role": {"const": "ADVERSARIAL_EXAMINER"}, "gate": {"const": "ADVERSARIAL"}}},
          {"properties": {"role": {"const": "SECURITY_BOUNDARY_EXAMINER"}, "gate": {"const": "SECURITY"}}},
          {"properties": {"role": {"const": "INDEPENDENT_VERIFIER"}, "gate": {"const": "QA"}}},
          {"properties": {"role": {"const": "BLACK_BOX_VERIFIER"}, "gate": {"const": "BLACK_BOX"}}}
        ]
      }
    },
    {
      "if": {"properties": {"message_type": {"const": "MINORITY_REPORT"}}, "required": ["message_type"]},
      "then": {
        "properties": {
          "role": {"const": "ADVERSARIAL_EXAMINER"},
          "gate": {"const": "ADVERSARIAL"},
          "status": {"const": "VETOED"},
          "minority_report": {"type": "object"},
          "checkpoint": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"message_type": {"const": "CHECKPOINT"}}, "required": ["message_type"]},
      "then": {
        "properties": {
          "role": {"const": "CHANGE_BUILDER"},
          "gate": {"const": "IMPLEMENTATION"},
          "status": {"const": "IN_PROGRESS"},
          "minority_report": {"type": "null"},
          "checkpoint": {"type": "object"}
        }
      }
    },
    {
      "if": {"properties": {"message_type": {"const": "RECOVERY"}}, "required": ["message_type"]},
      "then": {
        "properties": {
          "role": {"const": "CHANGE_BUILDER"},
          "gate": {"const": "RECOVERY"},
          "status": {"const": "PASS"},
          "minority_report": {"type": "null"},
          "resolves_message_ids": {"minItems": 1},
          "checkpoint": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"message_type": {"const": "CLOSURE"}}, "required": ["message_type"]},
      "then": {
        "properties": {
          "role": {"const": "CHANGE_BUILDER"},
          "gate": {"const": "CLOSURE"},
          "status": {"const": "COMPLETE"},
          "minority_report": {"type": "null"},
          "checkpoint": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"resolves_claim_ids": {"minItems": 1}}, "required": ["resolves_claim_ids"]},
      "then": {
        "properties": {
          "message_type": {"const": "VERIFICATION"},
          "role": {"const": "ADVERSARIAL_EXAMINER"},
          "gate": {"const": "ADVERSARIAL"},
          "status": {"const": "PASS"},
          "recommendation": {
            "properties": {
              "decision": {"enum": ["FIX_ACCEPTED", "RESOLVED_BY_EVIDENCE"]}
            }
          },
          "tests": {
            "minItems": 1,
            "items": {
              "properties": {
                "result": {"const": "PASS"},
                "exit_code": {"const": 0},
                "artifact": {"type": "string"}
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"resolves_message_ids": {"minItems": 1}}, "required": ["resolves_message_ids"]},
      "then": {
        "properties": {
          "message_type": {"const": "RECOVERY"},
          "role": {"const": "CHANGE_BUILDER"},
          "gate": {"const": "RECOVERY"},
          "status": {"const": "PASS"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {"enum": ["INDEPENDENT_VERIFIER", "BLACK_BOX_VERIFIER"]},
          "status": {"const": "PASS"}
        },
        "required": ["role", "status"]
      },
      "then": {
        "properties": {
          "tests": {
            "minItems": 1,
            "items": {"properties": {"result": {"const": "PASS"}}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {"enum": ["INDEPENDENT_VERIFIER", "BLACK_BOX_VERIFIER"]},
          "status": {"const": "FAIL"}
        },
        "required": ["role", "status"]
      },
      "then": {
        "properties": {
          "tests": {
            "minItems": 1,
            "items": {"properties": {"result": {"enum": ["PASS", "FAIL"]}}},
            "contains": {"properties": {"result": {"const": "FAIL"}}, "required": ["result"]}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {"enum": ["INDEPENDENT_VERIFIER", "BLACK_BOX_VERIFIER"]},
          "status": {"const": "RESULT_UNKNOWN"}
        },
        "required": ["role", "status"]
      },
      "then": {
        "properties": {
          "tests": {
            "minItems": 1,
            "items": {"properties": {"result": {"enum": ["PASS", "RESULT_UNKNOWN"]}}},
            "contains": {"properties": {"result": {"const": "RESULT_UNKNOWN"}}, "required": ["result"]}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {"enum": ["INDEPENDENT_VERIFIER", "BLACK_BOX_VERIFIER"]},
          "status": {"const": "VETOED"}
        },
        "required": ["role", "status"]
      },
      "then": {
        "properties": {
          "tests": {
            "minItems": 1,
            "items": {"properties": {"result": {"enum": ["PASS", "FAIL"]}}},
            "contains": {"properties": {"result": {"const": "FAIL"}}, "required": ["result"]}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"enum": ["PASS", "COMPLETE"]}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "evidence": {
            "items": {"properties": {"exit_code": {"enum": [0, null]}}}
          },
          "tests": {
            "items": {"properties": {"result": {"const": "PASS"}}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {"kind": {"const": "BLACK_BOX_OBSERVATION"}},
              "required": ["kind"]
            }
          }
        },
        "required": ["evidence"]
      },
      "then": {
        "properties": {"role": {"const": "BLACK_BOX_VERIFIER"}}
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "rfc3339": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000-)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\/$)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.|\\.git)(?:/|$))[^\\u0000\\\\*?\\[]+$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "locator", "digest", "exit_code", "observed_at", "redaction"],
      "properties": {
        "id": {"type": "string", "pattern": "^E-[0-9]{3}$"},
        "kind": {
          "enum": [
            "GIT_OBJECT",
            "FILE_SNAPSHOT",
            "COMMAND_RESULT",
            "TEST_REPORT",
            "DATABASE_ASSERTION",
            "HTTP_OBSERVATION",
            "HUMAN_AUTHORIZATION",
            "RESOURCE_SNAPSHOT",
            "BLACK_BOX_OBSERVATION"
          ]
        },
        "locator": {"type": "string", "minLength": 1, "maxLength": 512},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "exit_code": {"type": ["integer", "null"], "minimum": -255, "maximum": 255},
        "observed_at": {"$ref": "#/$defs/rfc3339"},
        "redaction": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  }
}
