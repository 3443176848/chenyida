  "risks": [
    {
      "id": "R-001",
      "severity": "CRITICAL",
      "probability": "MEDIUM",
      "impact": "A concurrent writer can make the controller read a different inode or follow a newly substituted symlink after validation, violating forbidden-context confidentiality and allowing a mixed-snapshot READY decision.",
      "trigger": "A checked file or an intermediate directory is replaced between _checked_path/path.stat and Path.open in _read_bytes.",
      "mitigation": "Open through verified directory/file descriptors with O_NOFOLLOW, compare inode/device/link/type metadata before and after reading, and fail closed on any change.",
      "residual_risk": "Prompt-level single-writer discipline does not technically prevent a concurrent or compromised writer from winning the race."
    }
  ],
  "blockers": [
    {
      "id": "B-001",
      "category": "TOCTOU_READ_BOUNDARY",
      "attempted": [
        "Reviewed the frozen _checked_path and _read_bytes control flow.",
        "Confirmed that symlink and hardlink checks occur before a separate path-based stat/open with no opened-descriptor identity comparison."
      ],
      "evidence_refs": ["E-001"],
      "unblock_owner": "builder-r1-5"
    }
  ],
  "recommendation": {
    "decision": "VETO",
    "reason": "The two prior exploits are closed by passing regressions: candidate/attempt rollback and same-candidate VETO replacement fail closed, and UAT marker paths are restricted to the two governance documents. However, readonly_controller._read_bytes validates pathname metadata and later re-resolves the pathname with Path.open without O_NOFOLLOW or fstat identity/stability checks. A concurrent substitution can bypass the symlink/hardlink boundary or produce a mixed trusted snapshot, which is a substantive R1.5 security defect.",
    "next_action": "Harden descriptor-based reads against substitution and add deterministic TOCTOU regression tests before refreezing the candidate."
  },
