  "risks": [
    {
      "id": "R-001",
      "severity": "HIGH",
      "probability": "LOW",
      "impact": "The runtime validator accepts a Task Packet that the versioned schema rejects, and its scope matcher can authorize a schema-invalid but repository-path-valid descendant. This breaks the required fail-closed schema/manual contract.",
      "trigger": "A recursive allowed_changed_paths value has a 510-character concrete prefix, making the full pattern 513 characters while a one-character descendant remains exactly 512 characters.",
      "mitigation": "Apply the 512-character bound to the complete pattern before removing the /** suffix and add 512/513 boundary parity tests.",
      "residual_risk": "Ordinary glob and nested .git cases are closed, but the length-boundary authorization divergence remains until fixed."
    }
  ],
